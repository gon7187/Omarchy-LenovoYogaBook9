#!/bin/bash
# Post-update: preserve the result and report failures without resetting user choices.
set -u
state="$HOME/.local/state/yoga-book"
mkdir -p "$state"
failed=0
"$HOME/.local/bin/yoga-recovery" snapshot >> "$state/post-update.log" 2>&1 || failed=1
"$HOME/.local/bin/yoga-recovery" check >> "$state/post-update.log" 2>&1 || failed=1
if (( failed )); then
  command -v notify-send >/dev/null && notify-send 'Yoga Book' 'После обновления нужна проверка панели. Выйди из сеанса и войди снова; отчёт: ~/.local/state/yoga-book/post-update.log'
fi
