{
  "yoga": {"icon": "󰍹", "label": "Yoga Book — экраны", "target": "setup.yoga"},
  "setup.yoga": {
    "icon": "󰍹",
    "label": "Yoga Book — экраны",
    "aliases": ["yoga"],
    "description": "Режимы экранов, автоповорот и яркость"
  },
  "setup.yoga.stand": {
    "icon": "󰌢",
    "label": "Обычный режим",
    "description": "Два экрана друг над другом",
    "action": "yoga-mode stand",
    "checked": "[ \"$(yoga-mode status)\" = stand ]"
  },
  "setup.yoga.book": {
    "icon": "󰒺",
    "label": "Книга",
    "description": "Два вертикальных экрана рядом",
    "action": "yoga-mode book",
    "checked": "[ \"$(yoga-mode status)\" = book ]"
  },
  "setup.yoga.bookflip": {
    "icon": "󰒺",
    "label": "Книга — обратный поворот",
    "description": "Вертикальные экраны с поворотом в другую сторону",
    "action": "yoga-mode book-flip",
    "checked": "[ \"$(yoga-mode status)\" = book-flip ]"
  },
  "setup.yoga.present": {
    "icon": "󱂉",
    "label": "Презентация",
    "description": "Зеркальное изображение для собеседника",
    "action": "yoga-mode present",
    "checked": "[ \"$(yoga-mode status)\" = present ]"
  },
  "setup.yoga.tablet": {
    "icon": "󰓶",
    "label": "Планшет",
    "description": "Вывернут на 360°: нижний экран и тач на нём выключены",
    "action": "yoga-mode tablet",
    "checked": "yoga-mode status | grep -q ^tablet"
  },
  "setup.yoga.widgets": {
    "icon": "󰖯",
    "label": "Виджеты верхнего экрана",
    "description": "Показать или скрыть часы, погоду, календарь и загрузку",
    "action": "yoga-widgets toggle",
    "checked": "yoga-widgets status | grep -q on"
  },
  "setup.yoga.autorotate": {
    "icon": "󰁨",
    "label": "Автоповорот",
    "description": "Включить или отключить поворот по датчику",
    "action": "yoga-autorotate-toggle",
    "checked": "yoga-autorotate-toggle status | grep -q on"
  },
  "setup.yoga.osd": {
    "icon": "󰄳",
    "label": "Индикатор яркости",
    "description": "Показывать индикатор при автоматической регулировке",
    "action": "yoga-autobrightness-osd",
    "checked": "yoga-autobrightness-osd status | grep -q on"
  },
  "setup.yoga.recover": {
    "label": "Вернуть обычные экраны",
    "description": "Отключить автоповорот и вернуть расположение друг над другом",
    "action": "/home/gon7187/.local/bin/yoga-reset-layout"
  },
  "setup.yoga.keyboard": {
    "label": "Клавиатура и тачпад",
    "description": "Панель ввода на нижнем экране",
    "action": "/home/gon7187/.local/bin/yoga-panel show"
  }
}
