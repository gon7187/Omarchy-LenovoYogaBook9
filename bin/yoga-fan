#!/usr/bin/env python3
"""Fan speeds of the Yoga Book 9, read from the embedded controller.

No driver exposes them: ideapad_laptop has no fan input, yogafan does not bind
to this model, and the five ACPI fans (PNP0C0B) only flip NVS variables the EC
ignores. The DSDT maps EC RAM at 0xFE0B0000 (region EMOR) with FANS and FA2S,
16-bit RPM of the two fans, at 0x5A2 and 0x5A4.

Measured under full load: both fans top out at ~3900 / ~6000 RPM when the
package reaches ~95 C, identically with fan_mode 0 and 4, so the EC runs them on
temperature alone and there is nothing to control from here.

Runs as root because /dev/mem is root-only. Maps that one page read-only and
writes "RPM1 RPM2" to /run/yoga-fan every 2 s; never writes to the EC.

  yoga-fan            run the daemon (yoga-fan.service)
  yoga-fan install    install this script and the system service (sudo/pkexec)
  yoga-fan remove
"""
import mmap, os, struct, subprocess, sys, time

OUT = '/run/yoga-fan'
EC_BASE, FANS = 0xFE0B0000, 0x5A2
UNIT = '/etc/systemd/system/yoga-fan.service'


def run():
    fd = os.open('/dev/mem', os.O_RDONLY | os.O_SYNC)
    ec = mmap.mmap(fd, mmap.PAGESIZE, mmap.MAP_SHARED, mmap.PROT_READ, offset=EC_BASE)
    while True:
        tmp = OUT + '.tmp'
        with open(tmp, 'w') as f: f.write('%d %d\n' % struct.unpack_from('<HH', ec, FANS))
        os.chmod(tmp, 0o644)
        os.replace(tmp, OUT)
        time.sleep(2)


def priv(*cmd):
    if os.geteuid() != 0: cmd = ('sudo' if sys.stdin.isatty() else 'pkexec',) + cmd
    subprocess.run(cmd, check=True)


def install():
    here = os.path.realpath(__file__)
    unit = ('[Unit]\nDescription=Yoga Book 9 fan speeds from the embedded controller\n\n'
            '[Service]\nExecStart=/usr/local/bin/yoga-fan\nRestart=on-failure\nRestartSec=2\n\n'
            '[Install]\nWantedBy=multi-user.target\n')
    priv('sh', '-c', f'install -Dm755 "{here}" /usr/local/bin/yoga-fan && printf %s "$1" > {UNIT} && '
         'systemctl daemon-reload && systemctl enable yoga-fan && systemctl restart yoga-fan', 'sh', unit)


if __name__ == '__main__':
    arg = sys.argv[1] if len(sys.argv) > 1 else 'run'
    if arg == 'run': run()
    elif arg == 'install': install()
    elif arg == 'remove':
        priv('sh', '-c', f'systemctl disable --now yoga-fan; rm -f {UNIT} /usr/local/bin/yoga-fan {OUT}; systemctl daemon-reload')
    else: sys.exit(__doc__)
