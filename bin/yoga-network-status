#!/bin/bash

# omarchy-network-status with the internet latency measured over TCP.
#
# The stock probe is an ICMP ping to 1.1.1.1, which the home VPN on the router
# drops, so the network panel sat at "Timeout / 100% loss" while the link was
# fine. The TCP connect time is no substitute either: the router answers the
# handshake itself (~1 ms). Time to the first byte of a real HTTP response is
# the first number that has actually been to the server and back.

out="$(omarchy-network-status "$@")"
[[ -n $out ]] || exit 0
[[ $out == *internet_ping_ms* ]] || { printf '%s\n' "$out"; exit 0; }

grep -v '^internet_ping_ms' <<<"$out"
ms="$(curl -so /dev/null -I -m 2 -w '%{time_starttransfer}' http://1.1.1.1/ 2>/dev/null | awk '$1 > 0 { printf "%.1f", $1 * 1000 }')"
printf 'internet_ping_ms\t%s\n' "$ms"
