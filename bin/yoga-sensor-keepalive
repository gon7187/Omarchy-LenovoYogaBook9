#!/usr/bin/env python3
"""Drain the INGENIC watchdog stream without logging or writing sensor data."""

import os
import sys
import termios
import tty


def drain(device: str) -> None:
    # Never acquire a controlling TTY: bytes can arrive before raw mode is set.
    fd = os.open(device, os.O_RDONLY | os.O_NOCTTY)
    try:
        tty.setraw(fd, termios.TCSANOW)
        while os.read(fd, 65536):
            pass
    finally:
        os.close(fd)


if __name__ == "__main__":
    drain(
        sys.argv[1]
        if len(sys.argv) > 1
        else "/dev/serial/by-id/usb-INGENIC_Gadget_Serial_and_keyboard_ingenic-if00"
    )
