#!/bin/bash

# Follow power-profiles-daemon: on every ActiveProfile change let yoga-mode
# switch the panels between HDR and 8-bit sRGB (see wanted_cm there).

set -u

yoga-mode refresh
gdbus monitor --system --dest org.freedesktop.UPower.PowerProfiles --object-path /org/freedesktop/UPower/PowerProfiles |
  while read -r line; do
    [[ $line == *ActiveProfile* ]] && yoga-mode refresh
  done
